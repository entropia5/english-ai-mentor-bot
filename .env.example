# Telegram Bot
TELEGRAM_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# Groq AI
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=1800

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=english_mentor
DB_USER=n8n
DB_PASSWORD=YOUR_DB_PASSWORD

# Optional when migrations are installed outside the project directory:
# MIGRATIONS_DIR=/usr/local/share/english_mentor/migrations
# RENDER_RESOURCES_DIR=/usr/local/share/english_mentor/resources/rendering

# Bot settings
BOT_NAME=English Mentor Bot
MAX_MESSAGE_LENGTH=3900

# Allowed users (comma separated)
ALLOWED_USERS=123456789,987654321
USER_1_ID=123456789

# Optional directory with conversation.json, medicine.json and it.json
# COURSE_CATALOG_DIR=resources/courses
